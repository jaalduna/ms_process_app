# Same-origin production build (JAA-433).
# The SPA is served by the backend from / on the App Service, and the API lives
# under /api/v1 on the same origin — so both are root-relative (no host, no
# /ms-process-app/ sub-path). Consumed by vite.config.ts (base) and the app
# (import.meta.env.VITE_BRIDGE_API_URL). `npm run build` picks this up
# automatically (production mode).
VITE_BASE_PATH=/
VITE_BRIDGE_API_URL=/api/v1

# Auth — Entra ID (MSAL) end-to-end. VITE_AUTH_PROVIDER wins over config.js
# (?? order in App.tsx), so this forces the MSAL provider regardless of any
# stale runtime config.js. SPA app registration: ms-process-app-prd (JAA-347).
VITE_AUTH_PROVIDER=azure-ad
VITE_AZURE_AD_CLIENT_ID=5ba595a5-2ef0-48d4-ad72-dc6b89269aa0
VITE_AZURE_AD_TENANT_ID=957d766b-8558-4771-b48f-a6c9e96a639f
# Redirect URI defaults to window.location.origin (auth-config.ts) = the App
# Service URL. That exact URI must be registered on the SPA app reg (JAA-347).
# API access-token scope — set ONLY after the SPA->API delegated permission is
# granted (SSO phase 2, JAA-347). While unset, login uses identity scopes only.
# VITE_AZURE_AD_API_SCOPE=api://6c3dd7bb-73e5-4859-af29-582ba23adfcb/Jobs.Execute
