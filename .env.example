# Azure AD OAuth configuration (used when authProvider = "msal")
VITE_AZURE_AD_CLIENT_ID=your-app-registration-client-id
VITE_AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173/ms-process-app/

# Bridge API URL
VITE_BRIDGE_API_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# GitHub OAuth — mock-server environment (set in mock-server/.env or shell)
# ---------------------------------------------------------------------------
# Create a GitHub OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_CALLBACK_URL below.
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
# URL of the frontend app (where the callback redirects after issuing the JWT)
FRONTEND_URL=http://localhost:5173
# Secret used to sign/verify app JWTs (change in production)
JWT_SECRET=dev-secret-change-in-production
# Optional comma-separated admin email whitelist.
# If empty, any GitHub-authenticated user gets admin + all countries.
ADMIN_EMAILS=
